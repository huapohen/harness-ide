{
  "name": "harness-ide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/hot-manifest.mjs",
    "start": "node server/index.mjs",
    "dev": "npm run build && node --watch server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "app": "bash scripts/build-app.sh",
    "postinstall": "node scripts/prepare-pty.mjs",
    "hot": "npm run build && node scripts/hot-publish.mjs",
    "hot:watch": "node scripts/hot-watch.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "dompurify": "3.4.15",
    "ghostty-web": "0.4.0",
    "marked": "15.0.12",
    "node-pty": "1.1.0",
    "prettier": "3.9.6",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2",
    "ws": "8.21.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "vite": "6.4.3"
  }
}
